node_modules
.pnp
.pnp.js

# Testing
coverage

# Next.js
.next/
out/
build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
ts-debug.log*

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Turbo
.turbo

# Bukti audit visual disimpan lokal, bukan di repo
tests/visual/

# Generated TypeScript output that sits beside its sources (tsc artifacts).
# Webpack dev resolves .js before .ts, so stale artifacts shadow real source.
# Build output in dist/ stays trackable (explicitly re-included below).
apps/web/**/*.js
apps/web/**/*.js.map
apps/web/**/*.d.ts
apps/web/**/*.d.ts.map
apps/api/**/*.js
apps/api/**/*.js.map
apps/api/**/*.d.ts
apps/api/**/*.d.ts.map
packages/types/**/*.js
packages/types/**/*.js.map
packages/types/**/*.d.ts
packages/types/**/*.d.ts.map
!apps/api/dist/**
!packages/types/dist/**

# Migration evidence is generated locally and stored in secure artifact storage.
artifacts/migration/
artifacts/promotion/
artifacts/membership/
artifacts/initial-production/

# ─── Kebersihan repo ───
# Media mentah input pipeline foto proker (diproses ke apps/web/public/uploads/proker).
# Di-untrack dan dibersihkan dari riwayat: file tetap ada di disk, tidak di GitHub.
# Backup wajib ada sebelum menjalankan process_images.ts.
apps/api/data/images/

# Media mentah proker (duplikat sebagian, tetap lokal)
data/proker/

# Environment / perangkat alat lokal
.kilo/

# Artefak audit visual (konsisten dengan tests/visual/ di atas)
.playwright-mcp/

# Knowledge graph generated
graphify-out/

# Output test
test-results/
e2e-public/
e2e-private/
apps/api/e2e-public/
apps/api/e2e-private/

# Log runtime
*.log

# Dump database lokal (dapat memuat data pribadi awardee)
backups/
