{
  "name": "genbi-jatim-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "evidence:readiness": "node scripts/write-readiness-evidence.mjs",
    "guard:staging-reset": "node scripts/guard-staging-reset.mjs",
    "verify:backup-restore": "node scripts/verify-mysql-backup-restore.mjs",
    "preflight:legacy-schema": "node scripts/legacy-schema-preflight.mjs",
    "check:schema-readiness": "node scripts/check-schema-readiness.mjs",
    "test:legacy-schema-preflight": "node --test scripts/legacy-schema-preflight.test.mjs",
    "check:migration-mode": "node scripts/check-migration-mode.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "2.11.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.0.0"
}
