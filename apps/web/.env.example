# Copy to .env.local (never commit secrets)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Canonical public site origin (used when generating absolute URLs).
SITE_URL=http://localhost:3000
# Server-only API origin. In Docker Compose use http://api:5000/api.
API_URL=http://localhost:5000/api
# 1 enables example news preview data; keep 0 in production.
NEXT_PUBLIC_NEWS_PREVIEW=0
