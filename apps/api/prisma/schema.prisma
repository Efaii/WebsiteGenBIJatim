generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  quote     String   @db.Text
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq")
}

model Commissariat {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  university  String
  logo        String
  logoGenbi   String   @default("/assets/logos/genbi.svg")
  coverImage  String   @default("/assets/images/raker.jpg")
  description String   @db.Text
  instagram   String?
  email       String?
  memberCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programKerja ProgramKerja[]
}

model ProgramKerja {
  id                String   @id @default(uuid())
  programKe         Int
  namaProker        String
  divisi            String
  tanggalProker     DateTime
  formatPelaksanaan String
  status            String
  deskripsiProker   String   @db.Text
  kpiTukTarget      String?  @db.Text
  dampak            String?  @db.Text
  evaluasi          String?  @db.Text
  linkProposalPdf   String?
  linkLpjPdf        String?
  dokumentasiDrive  String?
  foto1             String?
  foto2             String?
  foto3             String?
  foto4             String?
  foto5             String?
  foto6             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  commissariatId String
  commissariat   Commissariat @relation(fields: [commissariatId], references: [id])

  @@map("program_kerja")
}

model News {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  image     String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news")
}