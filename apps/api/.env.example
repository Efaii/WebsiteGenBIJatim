# Copy to .env (never commit .env)
DATABASE_URL="mysql://root:@localhost:3306/genbi_jatim"
PORT=5000
CORS_ORIGIN=http://localhost:3000
ADMIN_USERNAME=replace-with-explicit-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECRET=replace-with-a-long-random-secret
PUBLIC_STORAGE_ROOT=./public/uploads
PRIVATE_STORAGE_ROOT=./private/uploads
